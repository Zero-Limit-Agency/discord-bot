# Required. Never commit .env or real credentials.
DISCORD_TOKEN=
ZERO_LIMIT_OWNER_IDS=
CLIENT_ID=
# guild (test/client registration) or explicitly global (all installed guilds)
COMMAND_SCOPE=guild
GUILD_ID=
# Optional allowlist for a test process; blank allows all installed guilds.
ALLOWED_GUILD_IDS=
DISCORD_TEMPLATE_EXECUTION_ENABLED=false
PROTECTED_ROLE_IDS=1534218992619753622

# AI_PROVIDER=lmstudio|ollama|nvidia. No automatic paid fallback.
AI_PROVIDER=
LMSTUDIO_ENABLED=false
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_MODEL=
LMSTUDIO_API_KEY=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com
NVIDIA_MODEL=
NVIDIA_API_KEY=
LMSTUDIO_TIMEOUT_MS=180000
BUILD_PIPELINE_MODE=single
BUILD_AGENT_TIMEOUT_MS=900000
BUILD_ARCHITECT_TIMEOUT_MS=900000
BUILD_PERMISSIONS_TIMEOUT_MS=900000
BUILD_CONTENT_TIMEOUT_MS=900000
BUILD_ASSEMBLER_TIMEOUT_MS=900000
BUILD_AGENT_MAX_RETRIES=1
AI_SKILLS_ENABLED=true
AI_SKILLS_MAX_CHARS=2000
AI_SKILLS_MODE=minimal
ATTACHMENT_TEXT_MAX_BYTES=1048576
ATTACHMENT_FETCH_TIMEOUT_MS=10000
BUILD_BRIEF_MAX_CHARS=60000
# Enable Message Content intent in the Developer Portal before setting this true.
# Needed for complete member-authored ticket transcripts.
MESSAGE_CONTENT_ENABLED=false

# Legacy agency-only monitors, explicitly opt-in; not managed customer modules.
LEGACY_MONITORS_ENABLED=false
STATUS_CHANNEL_ID=
SOCIALS_CHANNEL_ID=
SITE_STATUS_URL=
RULES_BANNER_URL=
STAFF_ROLE_IDS=
STATUS_CHECK_INTERVAL_MS=60000
SOCIAL_CHECK_INTERVAL_MS=300000
SOCIAL_FEEDS_JSON=[]
